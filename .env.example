PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# If MongoDB is not reachable locally or on Atlas, server will automatically start an in-memory Mongo server
MONGODB_URI=mongodb://localhost:27017/master_drive

# Authentication & Security
JWT_SECRET=supersecret_master_drive_jwt_secret_key_change_in_production
# 64 hex characters (32 bytes) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/accounts/google/callback

# Storage Engine Settings
# Default chunk size in Megabytes (e.g. 10MB or 25MB)
DEFAULT_CHUNK_SIZE_MB=15
# Allow simulated accounts for testing without Google Cloud Console setup
ENABLE_MOCK_DRIVES=true
